{
  "name": "tiktok-replenishment",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "npm test && npm run build",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "package:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "read-excel-file": "9.3.14"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
